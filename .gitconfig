[user]
    email = szczygiel.p@gmail.com
    name = Piotr Szczygieł

[core]
    autocrlf = input

[pull]
    rebase = false

[fetch]
    prune = true

[diff]
    algorithm = histogram

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[url "git@github.com:"]
    insteadOf = gh:
    pushInsteadOf = github:
    pushInsteadOf = git://github.com/

[alias]
    main = !git checkout main 2>/dev/null || git checkout master
