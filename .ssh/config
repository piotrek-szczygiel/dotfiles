# Forgejo SSH runs on a non-default port.
Host git.szczygiel.dev
    Port 22222

# Git hosting: local per-machine key.
Host github.com git.szczygiel.dev
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    IdentityAgent none

# Everything else (servers): 1Password agent; macOS uses a different socket path.
Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
    IdentityAgent ~/.1password/agent.sock
